// -*- mode: jsonc -*-
{
    // "output": ["HDMI-A-1", "eDP-1"],
    "output": "eDP-1",
    "position": "top", // Bar pos
    "margin-top" : 0, // Margin around bar
    "margin-left": 5,
    "margin-right": 5,
    "spacing": 4, // Gaps between modules (4px)
    "reload_style_on_change": true,
    // Choose the order of the modules
    "modules-left": [
        "clock",
        // "hyprland/workspaces",
        "custom/spacer1",
        "hyprland/window",
        "group/start",
    ],
    "modules-center": [
        "group/widget",
        "mpris",
    ],
    "modules-right": [
        "hyprland/language",
        "tray",
        "network",
        "bluetooth",
        "group/status",
        "group/control",
        "group/power",
    ],

    // Modules
    "hyprland/language": {
      "format": "{}  ",
      "format-en": "EN",
      "format-en-colemak_dh": "Colemak",
      "format-sk": "SK"
    },

    "hyprland/window": {
      "format": "{initialClass}",
      "rewrite": {
        "org.qutebrowser.qutebrowser": "Qutebrowser",
        "com.mitchellh.ghostty": "Ghostty",
        "com.github.th_ch.youtube_music": "YouTube Music",
        "org.pwmt.zathura": "Zathura",
        "et": "Spreadsheets",
        "'custom.float'": "Floating Utility"
      }
    },

    "hyprland/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "default": "",
        "browser": "󰈹 ",
        "code": " ",
        "editor": " ",
        "text": " ",
        "misc": " ",
        "music": " ",
      },
      "persistent-only": true,
      "all-outputs": true,
      "ignore-workspaces": ["*."]
    },

    "mpris": {
      "format": "▶  {dynamic}",
      "format-paused": "⏸  {dynamic}",
      "dynamic-order": ["title", "artist", "album"],
      "dynamic-len": 60
    },

    "tray": {
      "icon-size": 11,
      "spacing": 5
    },

  "network": {
      "format": "{ifname}",
      "on-click": "ghostty --class='custom.float' --font-size=12 -e impala",
      "format-wifi": "",
      "format-ethernet": "󰈀",
      "format-linked": "",
      "format-disconnected": "󰞃",
      "tooltip-format": "{ifname} via {gwaddr} ",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)  ",
      "tooltip-format-ethernet": "{ifname} 󰈀 ",
      "tooltip-format-linked": "Linked  ",
      "tooltip-format-disconnected": "Disconnected",
      "max-length": 50
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%B %d}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%b %d}"
    },

    "cpu": {
      "format": " {usage}%",
      "tooltip": false,
      "on-click": "ghostty --class='custom.float' --font-size=12 -e btop -p 1",
    },

    "memory": {
      "format": " {}%",
      "on-click": "ghostty --class='custom.float' --font-size=12 -e btop -p 2",
    },

  "disk": {
    "interval": 30,
    "format": " {percentage_used}%",
    "tooltip": "{free} out of {total} available.",
    "on-click": "ghostty --class='custom.float' --font-size=12 -e bash -c 'dust -r / 2>/dev/null; read'",
  },

    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "on-click": "ghostty --class='custom.float' --font-size=12 -e btop -p 1",
    },

    // groups
    "group/start": {
      "modules": [
        "custom/menustart",
        "custom/script-nightlight",
        "custom/script-wallpaper",
        "custom/script-cleanup",
      ],
      "orientation": "inherit",
      "drawer": {}
    },
    "group/widget": {
      "modules" : [
        "custom/bartib",
        "custom/task"
      ],
      "orientation": "inherit",
    },

    "group/status": {
      "modules" : [
        "cpu",
        "custom/pacman",
        "custom/spacer1",
        "custom/weather",
        "custom/spacer1",
        "disk",
        "memory",
        "temperature"
      ],
      "orientation": "inherit",
      "drawer": {
        "transition-left-to-right": false,
      },
    },

    "group/control": {
      "modules" : [
        "pulseaudio",
        "backlight",
      ],
      "orientation": "inherit",
      "drawer": {
        "transition-left-to-right": false,
      },
    },

    "group/power": {
      "modules" : [
        "battery",
        "custom/shutdown",
      ],
      "orientation": "inherit",
      "drawer": {
        "transition-left-to-right": true,
      },
    },

    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        "reverse-scrolling": true,
    },

    "battery": {
      "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
      },
      "format": "{capacity}% {icon}",
      "format-full": "{capacity}% {icon}",
      "format-charging": "{capacity}% 󰂄",
      "format-plugged": "{capacity}% ",
      "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": [" ", " ", " ", " ", " "]
    },

    "bluetooth": {
      "format-off": "",
      "format-on": "󰂯",
      "format-connected": "󰂯 {device_alias}",
      "on-click": "ghostty --class='custom.float' -e bluetui"
    },

    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon} {volume}% {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
          "headphone": "",
          "hands-free": "",
          "headset": "",
          "phone": "",
          "portable": "",
          "car": "",
          "default": ["", "", ""]
        },
        "reverse-scrolling": true,
        "on-click": "ghostty --class='custom.float' -e wiremix",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // custom modules
    "custom/spacer1": {
      "format": "|",
      "tooltip": false
    },
    "custom/shutdown": {
      "format": "⏻ ",
      "tooltip-format": "Shut down",
      "on-click": "shutdown now"
    },

    "custom/bartib": {
      "format": "{icon}",
      "format-icons": {
        "true": "󱫌",
        "false": "" },
      "exec": "$HOME/.config/waybar/scripts/bartib",
      "return-type": "json",
      "on-click": "$HOME/.config/waybar/scripts/bartib -t",
      "interval": 60,
      "signal": 6,
      "markup": "pango"
   },
    "custom/task": {
      "format": "{text}",
      "exec": "$HOME/.config/waybar/scripts/task",
      "return-type": "json",
      "interval": 200,
      "on-click": "ghostty --class='custom.float' -e 'taskwarrior-tui'",
      "signal": 7,
      "markup": "pango"
   },

   "custom/pacman": {
     "format": " {text}",
     "tooltip-format": "You have {text} upgradeable packages.",
     "interval": "once",                     // every hour
     "exec": "checkupdates | wc -l",       // # of updates
     "exec-if": "exit 0",                  // always run; consider advanced run conditions
     "on-click":
     "hyprctl dispatch exec '[workspace special:hidden]ghostty --class='custom.float' --font-size=12 -e bash -c 'paru; pkill -SIGRTMIN+8 waybar''", // update system
     "signal": 8
   },

   "custom/weather": {
      "exec": "curl -s 'wttr.in?format=1' | sed 's/  //'",
      "interval": 300,
      "on-click": "ghostty --class='custom.float' --font-size=11 -e bash -c 'echo 'Loading...'; curl wttr.in | head -n -2; read'"
   },

   "custom/menustart": {
      "format": "\uE0B1",
      "tooltip": false
   },
   "custom/script-cleanup": {
      "format": "󰃢",
      "tooltip-format": "Perform a system cleanup.",
      "on-click": "$HOME/scripts/cleanup",
      "on-click-right": "ghostty --class='custom.float' -e $HOME/scripts/cleanup --aggressive",
      "class": "script"
   },
   "custom/script-wallpaper": {
      "format": "",
      "tooltip-format": "Change the wallpaper",
      "on-click": "$HOME/scripts/wallpaper-pick",
      "class": "script"
   },
   "custom/script-nightlight": {
      "format": "󱩌",
      "tooltip-format": "Toggle the night light",
      "on-click": "$HOME/scripts/nightlight",
      "class": "script"
   }

}
